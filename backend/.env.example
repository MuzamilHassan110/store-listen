NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Replace with a long random string in production
JWT_SECRET=dev-only-change-me-please
JWT_EXPIRES_IN=7d

# Required for POST /api/recordings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend only — never put this in /desktop or /frontend
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
LIVE_SUGGESTION_EVERY_N_CHUNKS=4

UPLOAD_DIR=uploads

# Optional WhatsApp Web session (QR). Leave false in CI/tests.
WHATSAPP_ENABLED=false
WHATSAPP_CHROME_PATH=

# Optional Twilio SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: password login via POST /api/auth/login
SUPABASE_ANON_KEY=

# AES-256-GCM for customer phones/emails. 64 hex chars. Per-record IVs are generated; ENCRYPTION_IV is unused.
# Desktop release metadata for GET /api/version (auto-update fallback)
DESKTOP_LATEST_VERSION=1.0.0
DESKTOP_MINIMUM_VERSION=1.0.0
DESKTOP_FORCE_UPDATE=false
DESKTOP_DOWNLOAD_URL=https://github.com/MuzamilHassan110/store-listen/releases
