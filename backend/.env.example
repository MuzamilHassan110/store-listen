NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Replace with a long random string in production
JWT_SECRET=dev-only-change-me-please
JWT_EXPIRES_IN=7d

# Required for POST /api/recordings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend only — never put this in /desktop or /frontend
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=60000

UPLOAD_DIR=uploads

# Optional WhatsApp Web session (QR). Leave false in CI/tests.
WHATSAPP_ENABLED=false
WHATSAPP_CHROME_PATH=

# Optional Twilio SMS fallback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
